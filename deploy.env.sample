# Both deploy targets use this key; its public key must be authorized on each server.
# If the key has a passphrase, load it into ssh-agent before deploying.
DEPLOY_SSH_KEY = ~/.ssh/your-ssh-key
DEPLOY_USER = your-user
DEPLOY_HOST = your.server.host
DEPLOY_PATH = /path/on/remote/server

DEPLOY_ONION_USER = your-user
DEPLOY_ONION_HOST = your.server.host
DEPLOY_ONION_PATH = /path/on/remote/server
